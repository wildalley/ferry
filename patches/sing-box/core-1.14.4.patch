new file mode 100644
--- /dev/null
+++ b/experimental/libbox/ferry_memory.go
@@ -0,0 +1,9 @@
+package libbox
+
+import "runtime/debug"
+
+// ConfigureFerryMemory preserves the Android GC policy used by libbox 1.13's
+// SetMemoryLimit(true). It does not enable the OOM service or reset connections.
+func ConfigureFerryMemory() {
+	debug.SetGCPercent(10)
+}
