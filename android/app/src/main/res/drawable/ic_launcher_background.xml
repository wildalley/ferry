<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon background (API 26+). Full-bleed: the launcher masks it and
     may shift it for parallax, so nothing here may carry meaning by position.
     AppPalette.dark.violet, lit from the upper left by violetSoft, under the
     white paper plane in ic_launcher_art. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF6A3BF0"
        android:pathData="M0,0h108v108h-108z" />
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="18"
                android:gradientRadius="96">
                <item android:offset="0" android:color="#66BCA8FF" />
                <item android:offset="1" android:color="#00BCA8FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
